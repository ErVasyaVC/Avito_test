@startuml user-cjm
start

:Открыть приложение;
:Выбрать категорию еды;
:Выбрать заведение из списка;

repeat
  repeat
    :Просмотреть меню;
    if (Товар в наличии?) then (да)
      :Добавить товар в корзину;
    else (нет)
      :Показать "нет в наличии";
    endif

    :Просмотреть корзину;
    if (Убрать товар из корзины?) then (да)
      :Удалить товар из корзины;
    else (нет)
    endif
  repeat while (Корзина пуста или хочет изменить состав?) is (да) not (нет)

  :Нажать "Оформить заказ";
  if (Все товары в корзине всё ещё доступны?) then (да)
  else (нет)
    :Убрать недоступные товары, показать "некоторые товары стали недоступны";
  endif
repeat while (Корзина опустела после проверки? / Добавить еще товаров) is (да) not (нет)

:Указать адрес доставки, контакты, оплата наличными курьеру;
:Заказ создан;

if (Заведение приняло заказ?) then (да)
  :Статус: принят;

  if (Пользователь отменяет заказ?) then (да)
    :Статус: отменён пользователем;
    stop
  else (нет)
  endif

  :Статус: готовится;

  if (Заведение отменяет заказ во время готовки?) then (да)
    :Статус: отменён заведением;
    stop
  else (нет)
  endif

  :Статус: готов;
  :Статус: доставляется;
  :Статус: доставлен;
else (нет)
  :Показать "заказ отклонён";
endif

stop
@enduml
