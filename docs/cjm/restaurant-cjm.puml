@startuml restaurant-cjm
start

repeat
  :Обновить меню (наличие, цены);
  :Ждать новый заказ;
  :Получить новый заказ;

  if (Все товары в наличии и есть мощности принять заказ?) then (да)
    :Принять заказ;
    :Статус: принят;

    :Начать готовить;
    :Статус: готовится;

    if (Что-то пошло не так во время готовки?) then (да)
      :Отменить заказ;
      :Статус: отменён заведением;
    else (нет)
      :Завершить готовку;
      :Статус: готов;
      note right: дальше статус доставки\n(доставляется -> доставлен)\nдвигает kitchen-api, не заведение
    endif
  else (нет)
    :Отклонить заказ;
    :Статус: отклонён;
  endif
repeat while (Продолжать принимать заказы?) is (да) not (нет)

stop
@enduml
