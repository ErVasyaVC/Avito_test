# Postgres для kitchen-db
POSTGRES_HOST=kitchen-db
POSTGRES_PORT=5432
POSTGRES_DB=kitchen
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=change_me

# Postgres для venue-db (отдельная база, database-per-service)
VENUE_POSTGRES_HOST=venue-db
VENUE_POSTGRES_PORT=5432
VENUE_POSTGRES_DB=venue
VENUE_POSTGRES_USER=venue
VENUE_POSTGRES_PASSWORD=change_me

# pgAdmin
PGADMIN_EMAIL=admin@example.com

# Межсервисная интеграция kitchen-api <-> venue-service (демо: одно заведение)
VENUE_SERVICE_URL=http://venue-service:8081
KITCHEN_API_URL=http://kitchen-api:8080
KITCHEN_VENUE_ID=a0000000-0000-0000-0000-000000000001
